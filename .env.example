# Supabase (région eu-central-1 imposée — RGPD, §7)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sert côté serveur uniquement : suppression de compte RGPD, écriture du
# statut de dossier, traitement de la file de notifications.
# Ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# Fournisseur de statut de vol (derrière FlightStatusProvider, lib/flight-status/)
# Sans cette clé, le mode démo local prend le relais HORS production
# uniquement (voir lib/flight-status/index.ts).
AVIATIONSTACK_API_KEY=

# Email transactionnel (Resend)
RESEND_API_KEY=
# Doit être une adresse d'un domaine vérifié chez Resend, sinon les envois
# vers les compagnies aériennes seront rejetés ou classés en spam.
RESEND_FROM_EMAIL=dossiers@volia.example

# Protège /api/notifications/traiter, qui envoie de vrais emails aux clients.
# Sans cette variable l'endpoint est désactivé (503). Générer une valeur
# aléatoire longue, par ex. : openssl rand -hex 32
CRON_SECRET=

# SEO (sitemap.ts)
NEXT_PUBLIC_SITE_URL=https://volia.example
