# ─── Base de données (obligatoire) ─────────────────────────────────────────────
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas

# ─── Modèle de langage (obligatoire pour l'analyse et l'exécution) ────────────
# Sans clé, Atlas fonctionne en mode dégradé : missions, étapes, documents et
# livrables manuels restent utilisables, mais aucune analyse IA n'est lancée.
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut : claude-opus-5)
ATLAS_MODEL=claude-opus-5
# Relecture automatique de chaque livrable par un second appel au modèle,
# juste après sa rédaction (activée par défaut ; « off » pour la désactiver).
# ATLAS_REVIEW=on

# ─── Recherche web (facultatif) ───────────────────────────────────────────────
# Renseigner une seule des deux clés. Sans clé, la recherche web est désactivée
# et Atlas l'indique clairement.
# ATLAS_SEARCH_PROVIDER=tavily   # tavily | brave | none (détection auto sinon)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ─── Stockage des fichiers importés ───────────────────────────────────────────
ATLAS_STORAGE_DIR=./storage
ATLAS_UPLOAD_MAX_MB=10
ATLAS_UPLOAD_MAX_PER_MISSION=20

# ─── Limites d'exécution (valeurs par défaut) ─────────────────────────────────
# ATLAS_MAX_ITERATIONS=24
# ATLAS_MAX_TOOL_CALLS=40
# ATLAS_MAX_RUN_SECONDS=600
# ATLAS_MAX_RUN_TOKENS=1500000
# ATLAS_MAX_IDENTICAL_CALLS=2
# ATLAS_MAX_CONSECUTIVE_ERRORS=5
# ATLAS_RUNS_PER_DAY=40
# ATLAS_ANALYSES_PER_DAY=150
# ATLAS_STALE_RUN_SECONDS=180

# ─── Reprises programmées (facultatif) ────────────────────────────────────────
# Secret (32 caractères ou plus) attendu par POST /api/internal/follow-ups,
# à appeler toutes les 15 minutes par une tâche planifiée (voir README).
# Sans lui, les reprises programmées ne se déclenchent pas.
# ATLAS_CRON_SECRET=

# ─── Adresse publique de l'application ───────────────────────────────────────
# Utilisée dans les liens des e-mails et les retours de paiement.
# ATLAS_APP_URL=https://atlas.exemple.fr

# ─── Paiement (Stripe) ────────────────────────────────────────────────────────
# Le paiement n'est actif que si TOUT est renseigné, identité légale comprise.
# Sans paiement actif, l'exécution est gratuite (usage de test).
# Mode "success" (par défaut) : carte enregistrée une fois, sans débit ;
# commission prélevée seulement quand le client déclare son problème réglé.
# Mode "upfront" : prix fixe payé avant qu'Atlas commence.
# ATLAS_BILLING_MODE=success
# ATLAS_SUCCESS_FEE_PCT=20          # part de la somme récupérée
# ATLAS_SUCCESS_FEE_MIN_CENTS=500   # commission minimale (5 €)
# ATLAS_SUCCESS_FEE_MAX_CENTS=3000  # commission maximale (30 €)
# ATLAS_SUCCESS_FEE_FLAT_CENTS=500  # résultat sans somme d'argent (résiliation obtenue…)
# ATLAS_PRICE_CENTS=1200            # mode "upfront" seulement : prix d'un dossier, en centimes TTC
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # webhook : /api/payments/stripe-webhook (checkout.session.completed, checkout.session.async_payment_succeeded)
# ATLAS_TERMS_VERSION=1

# ─── Identité légale du vendeur (mentions légales, CGV) ───────────────────────
# ATLAS_LEGAL_NAME="Prénom Nom EI"
# ATLAS_LEGAL_SIRET="123 456 789 00010"
# ATLAS_LEGAL_ADDRESS="1 rue ..., 75000 Paris"
# ATLAS_LEGAL_EMAIL=contact@atlas.exemple.fr
# ATLAS_LEGAL_HOST="Nom de l'hébergeur, adresse"
# ATLAS_LEGAL_MEDIATOR="Nom du médiateur de la consommation — site web"

# ─── Notifications par e-mail aux utilisateurs (Resend) ───────────────────────
# RESEND_API_KEY=re_...
# ATLAS_MAIL_FROM="Atlas <dossiers@atlas.exemple.fr>"

# ─── Plafond de coût IA par dossier (USD, 0 = aucun) ──────────────────────────
# ATLAS_MAX_COST_PER_MISSION_USD=3

# ─── Sessions et conservation ────────────────────────────────────────────────
# ATLAS_SESSION_DAYS=30
# Missions inactives depuis plus de N jours supprimées par `pnpm purge`
# ATLAS_RETENTION_DAYS=365

# ─── Propriétaire ─────────────────────────────────────────────────────────────
# E-mails (séparés par des virgules) qui voient la page « Économie » :
# ce que rapporte et coûte chaque dossier, et les alertes tirées des erreurs
# d'autres entreprises. Vide : personne.
# ATLAS_ADMIN_EMAILS=vous@exemple.fr
