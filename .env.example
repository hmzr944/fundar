# ─── Base de données (obligatoire) ─────────────────────────────────────────────
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas

# ─── Modèle de langage (obligatoire pour l'analyse et l'exécution) ────────────
# Sans clé, Atlas fonctionne en mode dégradé : missions, étapes, documents et
# livrables manuels restent utilisables, mais aucune analyse IA n'est lancée.
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut : claude-opus-5)
ATLAS_MODEL=claude-opus-5
# Relecture automatique de chaque livrable par un second appel au modèle,
# juste après sa rédaction (activée par défaut ; « off » pour la désactiver).
# ATLAS_REVIEW=on

# ─── Recherche web (facultatif) ───────────────────────────────────────────────
# Renseigner une seule des deux clés. Sans clé, la recherche web est désactivée
# et Atlas l'indique clairement.
# ATLAS_SEARCH_PROVIDER=tavily   # tavily | brave | none (détection auto sinon)
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ─── Stockage des fichiers importés ───────────────────────────────────────────
ATLAS_STORAGE_DIR=./storage
ATLAS_UPLOAD_MAX_MB=10
ATLAS_UPLOAD_MAX_PER_MISSION=20

# ─── Limites d'exécution (valeurs par défaut) ─────────────────────────────────
# ATLAS_MAX_ITERATIONS=24
# ATLAS_MAX_TOOL_CALLS=40
# ATLAS_MAX_RUN_SECONDS=600
# ATLAS_MAX_RUN_TOKENS=1500000
# ATLAS_MAX_IDENTICAL_CALLS=2
# ATLAS_MAX_CONSECUTIVE_ERRORS=5
# ATLAS_RUNS_PER_DAY=40
# ATLAS_ANALYSES_PER_DAY=150
# ATLAS_STALE_RUN_SECONDS=180

# ─── Reprises programmées (facultatif) ────────────────────────────────────────
# Secret (32 caractères ou plus) attendu par POST /api/internal/follow-ups,
# à appeler toutes les 15 minutes par une tâche planifiée (voir README).
# Sans lui, les reprises programmées ne se déclenchent pas.
# ATLAS_CRON_SECRET=

# ─── Sessions et conservation ────────────────────────────────────────────────
# ATLAS_SESSION_DAYS=30
# Missions inactives depuis plus de N jours supprimées par `pnpm purge`
# ATLAS_RETENTION_DAYS=365
