# Supabase (région eu-central-1 imposée — RGPD, §7)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sert côté serveur uniquement : suppression de compte RGPD, écriture du
# statut de dossier, traitement de la file de notifications.
# Ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# Fournisseur de statut de vol (derrière FlightStatusProvider, lib/flight-status/)
# Sans cette clé, le mode démo local prend le relais HORS production
# uniquement (voir lib/flight-status/index.ts).
AVIATIONSTACK_API_KEY=

# Email transactionnel (Resend)
RESEND_API_KEY=
# Doit être une adresse d'un domaine vérifié chez Resend, sinon les envois
# vers les compagnies aériennes seront rejetés ou classés en spam.
RESEND_FROM_EMAIL=dossiers@clearto.example

# Protège /api/notifications/traiter, qui envoie de vrais emails aux clients.
# Sans cette variable l'endpoint est désactivé (503). Générer une valeur
# aléatoire longue, par ex. : openssl rand -hex 32
CRON_SECRET=

# SEO (sitemap.ts)
NEXT_PUBLIC_SITE_URL=https://clearto.example

# Accès au tableau de bord d'exploitation (/admin) : emails séparés par des
# virgules. Fermé par défaut — non renseignée, la page est en 404 pour tout
# le monde, y compris vous.
ADMIN_EMAILS=

# ── Facturation ───────────────────────────────────────────────────────────
# Obligatoire avant la première facture : sans ces valeurs, l'émission est
# refusée plutôt que de produire une facture incomplète, donc contestable.
ENTREPRISE_RAISON_SOCIALE=
ENTREPRISE_FORME_JURIDIQUE=
ENTREPRISE_ADRESSE=
ENTREPRISE_SIREN=
# Laisser vide en franchise en base de TVA.
ENTREPRISE_TVA=
ENTREPRISE_MENTION_TVA=TVA non applicable, article 293 B du CGI
# Utilisés si Stripe n'est pas configuré : la facture part alors avec un RIB.
ENTREPRISE_IBAN=
ENTREPRISE_BIC=

# Facultatif. Sans clé, la facture bascule sur le virement bancaire.
# Un lien de paiement en un clic réduit fortement les impayés.
STRIPE_SECRET_KEY=
