# Supabase (région eu-central-1 imposée — RGPD, §7)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sert uniquement côté serveur (suppression de compte RGPD). Ne jamais exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# Fournisseur de statut de vol (derrière FlightStatusProvider, lib/flight-status/)
AVIATIONSTACK_API_KEY=

# Email transactionnel (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=dossiers@refundradar.example

# SEO (sitemap.ts)
NEXT_PUBLIC_SITE_URL=https://refundradar.example
